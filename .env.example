# External URL origin; scheme, hostname, optional port. No trailing path.
APP_ORIGIN=http://127.0.0.1:8790
# Use /food/ behind Nginx or / when hosted at a dedicated domain.
BASE_PATH=/
HOST=127.0.0.1
PORT=8790
DATA_DIR=./.data
# false retains a private site; true allows anonymous map browsing only.
PUBLIC_READ=false
# Leave empty to disable self-service registration. Set a private invitation code to enable it.
REGISTRATION_CODE=
